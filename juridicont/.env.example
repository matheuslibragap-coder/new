# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor (webhook de pagamento e exclusão de conta). Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (usada em redirecionamentos de login e pagamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic (Claude). Pela política comercial da Anthropic, dados enviados pela API
# não são usados para treinar modelos.
ANTHROPIC_API_KEY=
# Opcional: modelo e nível de esforço
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Asaas
ASAAS_API_KEY=
# sandbox: https://api-sandbox.asaas.com/v3 | produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Token definido por você ao cadastrar o webhook no painel do Asaas
ASAAS_WEBHOOK_TOKEN=
