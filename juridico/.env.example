# Nome exibido na interface
NEXT_PUBLIC_NOME_PRODUTO="Nome do Produto"
# URL pública da aplicação (links em e-mails, .ics, convites)
NEXT_PUBLIC_URL_APP=https://seu-dominio.com.br

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Jobs agendados (Vercel Cron envia Authorization: Bearer CRON_SECRET)
CRON_SECRET=

# DataJud: chave pública divulgada pelo CNJ em https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=
DATAJUD_INTERVALO_MS=500

# IA (M4 e M8)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Embeddings do banco de modelos (opcional; sem chave usa busca textual)
VOYAGE_API_KEY=

# E-mail (Resend)
RESEND_API_KEY=
EMAIL_REMETENTE="Avisos <avisos@seu-dominio.com.br>"

# Push (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seu-dominio.com.br

# Pagamentos (Asaas)
ASAAS_AMBIENTE=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Assinatura eletrônica (ZapSign)
ZAPSIGN_AMBIENTE=sandbox
ZAPSIGN_API_TOKEN=
ZAPSIGN_WEBHOOK_TOKEN=

# WhatsApp Cloud API (envio automático, plano Pro)
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE=atualizacao_processo
WHATSAPP_API_VERSION=v21.0

# Intimações (DJEN / Comunica PJe) [CONFERIR]
DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1
DJEN_INTERVALO_MS=1000
